msgstr "Antes de se autenticar com o PostyBirb, ative o acesso à API nas configurações da sua conta, em \"API (External Scripting)\"."

#: apps/postybirb-ui/src/components/website-login-views/twitter/twitter-login-view.tsx
msgid "You need to create a Twitter app to get API keys. <0>Visit Twitter Developer Portal</0>"
msgstr "Você precisa criar um aplicativo do Twitter para obter chaves de API. <0>Acesse o Portal do Desenvolvedor do Twitter</0>"

#: apps/postybirb-ui/src/components/website-login-views/twitter/twitter-login-view.tsx
msgid "You'll get this PIN after authorizing on Twitter"
msgstr "Você receberá este PIN após autorizar no Twitter"

#: apps/postybirb-ui/src/components/sections/submissions-section/submission-edit-card/account-selection/form/fields/description-field.tsx
msgid "Your description contains legacy shortcut syntax. These are no longer supported. Please use the new shortcut menu (type @, &lbrace; or `) to insert shortcuts."
msgstr "Sua descrição contém atalhos no formato antigo, que não é mais suportado. Use o novo menu de atalhos (digite @, &lbrace; ou `) para inserir atalhos."

#: apps/postybirb-ui/src/components/website-login-views/bluesky/bluesky-login-view.tsx
msgid "Your handle (e.g. <0>yourname.bsky.social</0>) or custom domain (e.g. <1>username.ext</1>)"
msgstr "Seu nome de usuário (por exemplo, <0>yourname.bsky.social</0>) ou domínio personalizado (por exemplo, <1>username.ext</1>)"

#: apps/postybirb-ui/src/components/website-login-views/inkbunny/inkbunny-login-view.tsx
